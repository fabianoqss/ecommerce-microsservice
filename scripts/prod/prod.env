# Configuração pública de produção; segredos vêm do OCI Vault.

# Containers e observabilidade
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=monitoring,apps
TRACING_SAMPLING_PROBABILITY=0.1

# PostgreSQL gerenciado: TLS com verificação do certificado e do hostname
ORDER_DB_URL='jdbc:postgresql://primary.7wlyv3wm7ptz2osd4hjet74onx33dq.postgresql.sa-saopaulo-1.oci.oraclecloud.com:5432/order-service?sslmode=verify-full&sslrootcert=/etc/ecommerce/oci-postgresql-ca.pem'
ORDER_DB_USERNAME=order_service
INVENTORY_DB_URL='jdbc:postgresql://primary.7wlyv3wm7ptz2osd4hjet74onx33dq.postgresql.sa-saopaulo-1.oci.oraclecloud.com:5432/inventory_service?sslmode=verify-full&sslrootcert=/etc/ecommerce/oci-postgresql-ca.pem'
INVENTORY_DB_USERNAME=inventory_service
KEYCLOAK_DB_URL='jdbc:postgresql://primary.7wlyv3wm7ptz2osd4hjet74onx33dq.postgresql.sa-saopaulo-1.oci.oraclecloud.com:5432/keycloak?sslmode=verify-full&sslrootcert=/etc/ecommerce/oci-postgresql-ca.pem'
KEYCLOAK_DB_USERNAME=keycloak

# Autonomous JSON privado: URI montada pelo gerador com a senha do Vault
PRODUCT_MONGODB_HOST=ccnlguvp.adb.sa-saopaulo-1.oraclecloudapps.com
PRODUCT_MONGODB_USERNAME=PRODUCT_SERVICE

# URLs públicas do Keycloak e do gateway
KEYCLOAK_HOSTNAME=https://auth.fabianoquirinos.com.br
GATEWAY_PUBLIC_URL=https://loja.fabianoquirinos.com.br

# OIDC: issuer público; JWKs, token e back-channel pela rede interna
OIDC_ISSUER_URI=https://auth.fabianoquirinos.com.br/realms/ecommerce
OIDC_JWK_SET_URI=http://keycloak:8080/realms/ecommerce/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://keycloak:8080/realms/ecommerce/protocol/openid-connect/token
OIDC_INTERNAL_ISSUER_URI=http://keycloak:8080/realms/ecommerce
OIDC_AUDIENCE=ecommerce-api

# SMTP do realm: OCI Email Delivery em São Paulo
KC_SMTP_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
KC_SMTP_PORT=587
KC_SMTP_FROM=noreply@loja.fabianoquirinos.com.br
KC_SMTP_STARTTLS=true
KC_SMTP_AUTH=true

# BFF: sessão protegida por HTTPS
BFF_POST_LOGIN_REDIRECT_URI=/bff/me
BFF_POST_LOGOUT_REDIRECT_URI=
SESSION_COOKIE_SECURE=true

# RabbitMQ: usuário público, senhas independentes no Vault
RABBITMQ_ADMIN_USERNAME=ecommerce-admin
