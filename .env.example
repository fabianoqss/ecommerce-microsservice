# Valores de DESENVOLVIMENTO LOCAL (docker-compose.dev.yml).
# Em produção, o mesmo conjunto de variáveis é gerado a partir do OCI Vault,
# apontando para os serviços da OCI.

# Containers (dev: "no"; produção usa o padrão unless-stopped)
RESTART_POLICY=no
COMPOSE_PROFILES=monitoring,apps

# PostgreSQL local (só dev: superusuário do container)
DB_PASSWORD=troque-por-uma-senha-forte

# Bancos por serviço (em produção: OCI Database with PostgreSQL, um usuário por serviço)
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_service
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=troque-por-uma-senha-forte
ORDER_DB_URL=jdbc:postgresql://postgres:5432/order-service
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=troque-por-uma-senha-forte
INVENTORY_DB_URL=jdbc:postgresql://postgres:5432/inventory_service
INVENTORY_DB_USERNAME=postgres
INVENTORY_DB_PASSWORD=troque-por-uma-senha-forte

# MongoDB (em produção: URI do Autonomous JSON com API MongoDB)
PRODUCT_MONGODB_URI=mongodb://mongo:27017/product_db

# auth-service
JWT_SECRET=troque-esta-chave-por-uma-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=TroqueEstaSenha@2026

# Keycloak (em produção: banco keycloak no OCI Database with PostgreSQL)
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_ADMIN_PASSWORD=troque-senha-do-console-admin
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=troque-senha-do-banco-keycloak
KC_BFF_CLIENT_SECRET=troque-segredo-do-client-ecommerce-bff
KC_ORDER_SERVICE_CLIENT_SECRET=troque-segredo-do-client-order-service
KC_ADMIN_USER_EMAIL=admin@ecommerce.local
KC_ADMIN_USER_PASSWORD=troque-senha-com-12-caracteres-ou-mais

# OIDC do api-gateway (issuer = KEYCLOAK_HOSTNAME público; JWKs pela rede interna)
OIDC_ISSUER_URI=http://localhost:8180/realms/ecommerce
OIDC_JWK_SET_URI=http://keycloak:8080/realms/ecommerce/protocol/openid-connect/certs
OIDC_AUDIENCE=ecommerce-api

# RabbitMQ (substitui guest/guest)
RABBITMQ_USERNAME=ecommerce
RABBITMQ_PASSWORD=troque-senha-do-rabbitmq

# Redis (sessões do api-gateway)
REDIS_PASSWORD=troque-senha-do-redis

# Grafana
GRAFANA_ADMIN_PASSWORD=troque-senha-do-grafana
