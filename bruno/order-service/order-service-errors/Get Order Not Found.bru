meta {
  name: Get Order Not Found
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/order/00000000-0000-7000-8000-000000000000
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Requires {{accessToken}} (token do Keycloak).
  Um UUID válido que não existe em tb_orders (um id que não é UUID, ex. /api/order/123, responde 400).

  Expected: 404 NOT FOUND — OrderNotFoundException, via ProblemDetail
  (GlobalExceptionHandler.handleOrderNotFound).
}
