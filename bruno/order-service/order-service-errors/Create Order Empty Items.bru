meta {
  name: Create Order Empty Items
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/order
  body: json
  auth: inherit
}

body:json {
  {
    "items": []
  }
}

docs {
  Herda o token de usuário da coleção. Lista vazia viola @NotEmpty em OrderRequestDTO.
  Esperado: 400 BAD_REQUEST via ProblemDetail, propriedade errors contendo items.
}
