meta {
  name: Create Product No Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/product
  body: json
  auth: none
}

body:json {
  {
    "name": "Sem Token",
    "description": "Produto criado sem nenhum header de autenticação",
    "price": 9.90,
    "category": "Teste",
    "imageUrl": ""
  }
}

tests {
  test("Não envia autenticação de usuário", function () {
    expect(req.getHeader("Authorization")).to.be.undefined;
    expect(req.getHeader("authorization")).to.be.undefined;
    expect(req.getHeader("Cookie")).to.be.undefined;
    expect(req.getHeader("cookie")).to.be.undefined;
  });
  test("POST anônimo respeita a cadeia de segurança do ambiente", function () {
    const expectedStatus = bru.getEnvName() === "Gateway" ? 403 : 401;
    expect(res.getStatus()).to.equal(expectedStatus);
  });
}

docs {
  auth: none desativa explicitamente o OAuth2 herdado da coleção; não há header
  Authorization manual. Desative o envio de cookies no Bruno (ou limpe a sessão BFF)
  para não autenticar pelo cookie SESSION. Na CLI, use --disable-cookies.
  Esperado no Gateway: 403 FORBIDDEN. Sem Bearer nem cookie, este POST entra na cadeia
  de sessão; o filtro CSRF rejeita a ausência do token CSRF antes da autorização.
  Esperado em ProductDirect: 401 UNAUTHORIZED; o serviço valida a autenticação por conta própria.
  Um token válido salvo na coleção não altera o cenário, pois auth: none evita seu envio.
  Bearer inválido é outro cenário: seleciona a cadeia Bearer do gateway e recebe 401.
}
