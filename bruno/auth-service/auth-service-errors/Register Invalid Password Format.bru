meta {
  name: Register Invalid Password Format
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Tester",
    "email": "bruno.badpassword@ecommerce.dev",
    "password": "abcdefgh"
  }
}

docs {
  Password is 8+ chars but has no uppercase, digit or special character — fails
  RegisterRequestDTO's @Pattern regex
  (^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&#])[A-Za-z\d@$!%*?&#]{8,}$).

  Expected: 400 BAD_REQUEST with a "password" entry in the error map.
}
