meta {
  name: Reserve Insufficient Stock
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/inventory/reserve
  body: json
  auth: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{keycloakUrl}}/realms/ecommerce/protocol/openid-connect/token
  client_id: order-service
  client_secret: {{orderServiceClientSecret}}
  scope: inventory:reserve
  credentials_placement: basic_auth_header
  credentials_id: order-service
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

script:pre-request {
  if (bru.getEnvName() !== "InventoryDirect") {
    throw new Error("Contrato interno: selecione InventoryDirect; o gateway nega reserve/release (403).");
  }
}

body:json {
  {
    "items": [
      {
        "skuCode": "{{productId}}",
        "quantity": 999999
      }
    ]
  }
}

docs {
  Execute Insert Inventory Item antes. Envia quantidade maior que as 50 unidades inseridas.
  Contrato interno: InventoryDirect, client_credentials order-service, scope inventory:reserve.
  Preencha a variável secreta local orderServiceClientSecret. Gateway nega a rota (403);
  a guarda local impede executar este cenário em outros ambientes.
  Esperado: 409 CONFLICT via ProblemDetail (InsufficientStockException).
}
