meta {
  name: Update Inventory Not Found
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/inventory/999999999
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "quantity": 10
  }
}

docs {
  A numeric id that doesn't exist in tb_inventory.

  Expected: 404 NOT FOUND — InventoryNotFoundException, via ProblemDetail
  (GlobalExceptionHandler.handleNotFound).
}
