meta {
  name: Release Stock
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/inventory/release
  body: json
  auth: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{keycloakUrl}}/realms/ecommerce/protocol/openid-connect/token
  client_id: order-service
  client_secret: {{orderServiceClientSecret}}
  scope: inventory:reserve
  credentials_placement: basic_auth_header
  credentials_id: order-service
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

script:pre-request {
  if (bru.getEnvName() !== "InventoryDirect") {
    throw new Error("Contrato interno: selecione InventoryDirect; o gateway nega reserve/release (403).");
  }
}

body:json {
  {
    "items": [
      {
        "skuCode": "{{productId}}",
        "quantity": 1
      }
    ]
  }
}

docs {
  Contrato interno order-service → inventory-service, só no ambiente InventoryDirect.
  OAuth2 client_credentials usa order-service e o scope inventory:reserve.
  Preencha orderServiceClientSecret como variável secreta local; ADMIN não substitui o scope.
  O gateway nega reserve/release para qualquer cliente (403); a guarda local impede
  usar a credencial de serviço nos outros ambientes.

  Compensa Reserve Stock incrementando o estoque. Não verifica se houve reserva antes;
  um skuCode inexistente não altera nenhuma linha.
  Esperado: 204 No Content.
}
